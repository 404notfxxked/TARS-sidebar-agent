{
  "manifest_version": 3,
  "name": "TARS — 侧栏智能助手",
  "version": "1.4.0",
  "description": "住在浏览器侧栏的 AI agent：读你正在看的页面，替你联网查、点按填写，可跨会话记住偏好。BYOK 接自己的模型，数据不出本机。",
  "permissions": [
    "sidePanel",
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "offscreen",
    "notifications"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "打开 TARS",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "minimum_chrome_version": "116"
}
