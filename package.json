{
  "name": "sidebar-agent",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.12.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/postbuild-offscreen.mjs",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "icons:export": "node scripts/export-icons.mjs",
    "tokens:m3": "node scripts/generate-m3.mjs"
  },
  "dependencies": {
    "highlight.js": "^11.11.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@material/material-color-utilities": "^0.3.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/chrome": "^0.0.270",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "0.25.12",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
