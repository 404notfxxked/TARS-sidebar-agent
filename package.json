{
  "name": "sidebar-agent",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "packageManager": "pnpm@10.12.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "tsc --noEmit && node scripts/check-version.mjs && node scripts/check-i18n.mjs && vite build && node scripts/postbuild-offscreen.mjs",
    "watch": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests scripts",
    "lint:fix": "biome check --write --unsafe src tests scripts",
    "icons:export": "node scripts/export-icons.mjs",
    "tokens:m3": "node scripts/generate-m3.mjs",
    "catalog:refresh": "node scripts/fetch-model-catalog.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "highlight.js": "^11.11.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@material/material-color-utilities": "^0.3.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/chrome": "^0.0.270",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "5.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "esbuild": "0.25.12",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.0"
  }
}
